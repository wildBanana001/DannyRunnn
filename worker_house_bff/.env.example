MODE=mock
CLOUD_ENV_ID=your-cloud-env-id
CLOUD_APP_ID=your-wechat-app-id
CLOUD_APP_SECRET=your-wechat-app-secret
# BFF 与云函数共同配置的高强度随机服务密钥，禁止提交真实值。
CLOUD_ADMIN_SERVICE_TOKEN=
ADMIN_TOKEN=mock-admin-token
ADMIN_OPENID_WHITELIST=
PORT=4000

# 云托管临时文件存储仅用于联调；生产环境不要开启。
ALLOW_EPHEMERAL_CLOUDRUN_DATA=false

# 新订单开关；支付回调和历史订单查询不会随该开关卸载。
ENABLE_SHOP=false
SHOP_ORDER_STORAGE=file
# 生产云托管使用内置 MySQL；本地 mock 默认仍使用 file。
MYSQL_ADDRESS=
MYSQL_USERNAME=
MYSQL_PASSWORD=
MYSQL_DATABASE=worker_house
MYSQL_CONNECTION_LIMIT=5
# 首次初始化可临时设为 true；流水线已执行 SQL 时保持 false。
MYSQL_AUTO_MIGRATE=true
WECHAT_APP_ID=
WECHAT_PAY_MCH_ID=
WECHAT_PAY_SERIAL_NO=
# 支持 base64 编码的 PEM，或使用 \n 转义的原始 PEM。
WECHAT_PAY_PRIVATE_KEY=
WECHAT_PAY_API_KEY_V3=
WECHAT_PAY_NOTIFY_URL=
# 推荐使用微信支付公钥模式（商户平台下载），也兼容旧的平台证书变量名。
WECHAT_PAY_PUBLIC_KEY=
WECHAT_PAY_PUBLIC_KEY_ID=
